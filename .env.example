# ─────────────────────────────────────────────
# AI Helpdesk — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Database ──
DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk_pass@localhost:5432/helpdesk_db

# ── Google Gemini ──
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSION=768

# ── Retrieval ──
RETRIEVAL_SIMILARITY_THRESHOLD=0.35

# ── JWT Auth ──
JWT_SECRET=change-me-to-a-strong-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ──
# REQUIRED for Vercel deployment — set to your backend URL
# Example: NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── File Upload ──
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
